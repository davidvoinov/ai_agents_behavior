# Copy this file to ".env" and fill in your key(s). Never commit the real .env.

# Which provider to use. Options: groq | openrouter | cerebras
LLM_PROVIDER=groq

GROQ_API_KEY=your-groq-key-here          # https://console.groq.com/keys
OPENROUTER_API_KEY=your-openrouter-key   # https://openrouter.ai/keys
CEREBRAS_API_KEY=your-cerebras-key       # https://cloud.cerebras.ai

PILOT_N=5
LLM_TEMPERATURE=1.0
COMM_ROUNDS=2

# Full-run knobs (run_full.py)
N_NO_HISTORY=32
N_SOCIAL_HISTORY=28
N_COMM=32

# Additional free, trial, or low-cost provider keys
GOOGLE_API_KEY=your-google-api-key-here   # https://aistudio.google.com/app/apikey
DEEPSEEK_API_KEY=your-deepseek-api-key-here   # https://platform.deepseek.com/api_keys
MISTRAL_API_KEY=your-mistral-api-key-here   # https://console.mistral.ai/
TOGETHER_API_KEY=your-together-api-key-here   # https://api.together.ai/settings/api-keys
HUGGINGFACE_API_KEY=your-huggingface-api-key-here   # https://huggingface.co/settings/tokens
FIREWORKS_API_KEY=your-fireworks-api-key-here   # https://fireworks.ai/api-keys
