# Copy this file to ".env" and fill in your key(s). Never commit the real .env.

# Which provider to use. Options: groq | openrouter | cerebras
LLM_PROVIDER=groq

GROQ_API_KEY=your-groq-key-here          # https://console.groq.com/keys
OPENROUTER_API_KEY=your-openrouter-key   # https://openrouter.ai/keys
CEREBRAS_API_KEY=your-cerebras-key       # https://cloud.cerebras.ai

PILOT_N=5
LLM_TEMPERATURE=1.0
COMM_ROUNDS=2

# Full-run knobs (run_full.py)
N_NO_HISTORY=32
N_SOCIAL_HISTORY=28
N_COMM=32
