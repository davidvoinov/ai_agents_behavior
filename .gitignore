# Secrets
.env

# Working notes and the manuscript, kept out of version control by decision
notes/
paper/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store

# Run logs
*.log

# Superseded copies and rollback snapshots, kept on disk under data/_archive
berg/data/_archive/
berg/_archive/
*.bak
*.bak_*
*.prepurge
*.predupe

# ---------------------------------------------------------------------------
# Experiment output.
#
# The rule is that a run reaches the repository when an estimate in the paper
# rests on it: the fifteen configurations of the main design with their
# attrition records and removed dyads, the fourteen arms of the incentive
# control, the recognition probe, the coded transcripts, and the pilot behind
# the power calculation. Everything else stays on disk.
# ---------------------------------------------------------------------------
berg/data/*
!berg/data/full/
!berg/data/batch/
!berg/data/incentive/
!berg/data/coding/
!berg/data/probe/
!berg/data/pilot/

# the main design, one file per configuration, and nothing else from that folder
berg/data/full/*
!berg/data/full/full_deepseek-v4-flash.jsonl
!berg/data/full/full_deepseek-v4-pro.jsonl
!berg/data/full/full_deepseek-v4-pro-think.jsonl
!berg/data/full/full_glm-5.2-nothink.jsonl
!berg/data/full/full_glm-5.2-think.jsonl
!berg/data/full/full_gpt-oss-120b.jsonl
!berg/data/full/full_kimi-k3.jsonl
!berg/data/full/full_llama-3.3-70b.jsonl
!berg/data/full/full_minimax-m3-nothink.jsonl
!berg/data/full/full_minimax-m3-think.jsonl
!berg/data/full/full_qwen3-nothink.jsonl
!berg/data/full/full_deepseek-v4-flash_attrition.jsonl
!berg/data/full/full_deepseek-v4-pro_attrition.jsonl
!berg/data/full/full_deepseek-v4-pro-think_attrition.jsonl
!berg/data/full/full_glm-5.2-nothink_attrition.jsonl
!berg/data/full/full_glm-5.2-think_attrition.jsonl
!berg/data/full/full_gpt-oss-120b_attrition.jsonl
!berg/data/full/full_kimi-k3_attrition.jsonl
!berg/data/full/full_llama-3.3-70b_attrition.jsonl
!berg/data/full/full_minimax-m3-nothink_attrition.jsonl
!berg/data/full/full_minimax-m3-think_attrition.jsonl
!berg/data/full/full_qwen3-nothink_attrition.jsonl
!berg/data/full/full_deepseek-v4-flash_purged.jsonl
!berg/data/full/full_deepseek-v4-pro_purged.jsonl
!berg/data/full/full_deepseek-v4-pro-think_purged.jsonl
!berg/data/full/full_glm-5.2-nothink_purged.jsonl
!berg/data/full/full_glm-5.2-think_purged.jsonl
!berg/data/full/full_gpt-oss-120b_purged.jsonl
!berg/data/full/full_kimi-k3_purged.jsonl
!berg/data/full/full_llama-3.3-70b_purged.jsonl
!berg/data/full/full_minimax-m3-nothink_purged.jsonl
!berg/data/full/full_minimax-m3-think_purged.jsonl
!berg/data/full/full_qwen3-nothink_purged.jsonl

# the four closed frontier arms
berg/data/batch/*/*
!berg/data/batch/*/full_*.jsonl

# the incentive control
berg/data/incentive/*
!berg/data/incentive/incentive_*.jsonl
berg/data/incentive/incentive_qwen3-think*

# the coded transcripts and every validation round
!berg/data/coding/**

